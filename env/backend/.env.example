# Copy to a local .env and fill in secrets. Never commit .env.
# Server-side Gemini key for embeddings only; BYOK chat keys come from clients.
GEMINI_API_KEY=your-gemini-api-key
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Set true only when serving the app over HTTPS (Secure cookies).
SECURE_COOKIES=false
# Comma-separated SPA origins for CORS and CSRF (credentials + X-CSRFToken).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
CHAT_RATE_LIMIT=30
DATABASE_URL=postgres://pensieve:pensieve@127.0.0.1:5434/pensieve
REDIS_URL=redis://127.0.0.1:6380/0
