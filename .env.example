# Pensieve — copy to .env and fill in values. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CHAT_RATE_LIMIT=30
# Local Docker Compose Postgres (pgvector image; host port 5433):
DATABASE_URL=postgres://pensieve:pensieve@127.0.0.1:5433/pensieve
